# .env.example — Orqafy Self-Hosted (TRACKED template — placeholders only, NO real values)
# Copy to .env.dev and fill. .env.dev is gitignored. Dev ports use Rule-22 non-standard
# values generated per-install; the numbers below are illustrative placeholders only.
COMPOSE_PROJECT_NAME=orqafy_dev
NODE_ENV=development

# ── Ports (Rule-22 non-standard — generate your own base to avoid local collisions) ──
APP_PORT=<app-port>
POSTGRES_PORT=<postgres-port>
PGBOUNCER_PORT=<pgbouncer-port>
VALKEY_PORT=<valkey-port>
MINIO_PORT=<minio-port>
MINIO_CONSOLE_PORT=<minio-console-port>
PGADMIN_PORT=<pgadmin-port>
MAILHOG_SMTP_PORT=<mailhog-smtp-port>
MAILHOG_UI_PORT=<mailhog-ui-port>

# ── PostgreSQL / PgBouncer ──
POSTGRES_DB=orqafy_dev
POSTGRES_USER=<db-user>
POSTGRES_PASSWORD=<generated-22-char>
PGBOUNCER_AUTH_PASSWORD=<generated-22-char>
# App connects via PgBouncer (transaction pooling). `?pgbouncer=true` is REQUIRED —
# it disables Prisma's named prepared statements, which otherwise collide across
# pooled backends (PG 42P05 "prepared statement sN already exists" / 26000
# "... does not exist"). Migrations use DIRECT_URL (direct Postgres), never pooled.
DATABASE_URL=postgresql://<db-user>:<password>@localhost:<pgbouncer-port>/orqafy_dev?pgbouncer=true
DIRECT_URL=postgresql://<db-user>:<password>@localhost:<postgres-port>/orqafy_dev

# ── Valkey / Redis ──
REDIS_PASSWORD=<generated-22-char>
REDIS_URL=redis://:<password>@localhost:<valkey-port>

# ── MinIO ──
MINIO_ROOT_USER=<access-key>
MINIO_ROOT_PASSWORD=<generated-48-char>
S3_ENDPOINT=http://localhost:<minio-port>
S3_ACCESS_KEY=<access-key>
S3_SECRET_KEY=<generated-48-char>
S3_BUCKET=orqafy-dev

# ── pgAdmin ──
PGADMIN_DEFAULT_EMAIL=<email>
PGADMIN_DEFAULT_PASSWORD=<generated-22-char>

# ── Auth.js v5 ──
AUTH_SECRET=<generated-48-char>
AUTH_URL=http://localhost:<app-port>

# ── OCR sidecar (profile-gated: `--profile ocr`) ──
# OCR_URL = internal service DNS the worker POSTs to; OCR_PORT publishes to host.
OCR_URL=http://ocr:9003
OCR_PORT=9003
# Shared secret the worker sends to the OCR sidecar; generate a random value per deployment.
OCR_SHARED_SECRET=
