# Dev image for @orqafy/jobs (BullMQ worker). dev_build:true — built from source.
# ⚠ Rebuild alongside the app (deploy-discipline): an app-only rebuild leaves this
# worker on stale code.
#
# Design: the worker is esbuild-BUNDLED into one ESM file (packages/jobs/
# scripts/build.mjs -> dist/main.mjs, node22). The bundle inlines @orqafy/jobs
# + the @orqafy/{db,shared,storage} workspace TS sources + their pure-JS deps.
# Only two packages stay external and are installed as real node_modules:
#   - @prisma/client (needs the generated `.prisma/client` query engine)
#   - bullmq         (Lua scripts / helpers resolved from disk)
#
# Build isolation: the install is scoped to @orqafy/jobs's own dependency graph
# (`--filter "@orqafy/jobs..."`), so apps/web, apps/mobile and packages/ui are
# never resolved/fetched here and their pnpm trustPolicy / minimumReleaseAge
# hits cannot block the worker build. `--filter @orqafy/db` is named
# separately on purpose: pnpm only installs devDependencies (the `prisma` CLI
# needed for `prisma generate`) for projects NAMED by a selector, not ones
# reached only through `...`. The runtime node_modules is copied from the
# build stage's virtual store (just the two externals' subtree), so it is
# lockfile-exact and carries the workspace's minimumReleaseAge / trustPolicy
# vetting — there is no second, unguarded install.
#
# Hardening kept: no devDependencies at runtime (audit L-10), npm removed
# (audit H-5), `apk upgrade`, and no pnpm/corepack in the runtime image — the
# container starts `node dist/main.mjs` directly.

# ---- build: scoped install, prisma generate, bundle ----
FROM node:22-alpine AS build

RUN apk add --no-cache libc6-compat openssl bash \
  && apk upgrade --no-cache

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

WORKDIR /app
COPY . .

# CI=true (install-scoped, not persistent ENV) lets pnpm purge any node_modules dir
# that slips past .dockerignore without a TTY (ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY).
RUN CI=true pnpm install --frozen-lockfile \
    --filter "@orqafy/jobs..." --filter @orqafy/db \
  && pnpm --filter @orqafy/db exec prisma generate \
  && pnpm --filter @orqafy/jobs build

# Runtime externals, LOCKFILE-EXACT: copy bullmq + @prisma/client and their
# resolved dependency subtree out of the virtual store that the frozen-lockfile
# install above populated (so pnpm-workspace.yaml's minimumReleaseAge /
# trustPolicy already vetted every one of them). The generated `.prisma/client`
# sits in the @prisma/client slot already. `prisma` CLI / `typescript` peers are
# skipped.
RUN node packages/jobs/scripts/collect-externals.mjs /rt \
    packages/jobs/node_modules/bullmq packages/db/node_modules/@prisma/client

# ---- runtime: lean alpine, no build tooling, no devDependencies anywhere ----
FROM node:22-alpine

RUN apk add --no-cache libc6-compat openssl \
  && apk upgrade --no-cache

WORKDIR /app
COPY --from=build /rt/node_modules ./node_modules
COPY --from=build /app/packages/jobs/dist/main.mjs ./dist/main.mjs

# Drop npm's bundled tree (audit H-5) — carries CRITICAL tar/pacote/sigstore/
# brace-expansion CVEs and never runs at runtime.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

CMD ["node", "dist/main.mjs"]
